+        name,
+        type: obj.userData?.type || 'unknown',
+        distance,
+        screenX,
+        screenY,
+        onScreen,
+        behind,
+        selected: obj.userData?.id === this.selectedObjectId
+      });
+    }
+    return result;
+  }
